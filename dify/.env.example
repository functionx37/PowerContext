# 复制为 .env 后修改。不填时 run_local.py 自动生成随机 SHOP_API_KEY。
SHOP_API_KEY=replace-with-a-random-secret-at-least-16-chars
# 仅使用独立运行的 server.py 时需要；run_local.py 自动配置此地址。
POWERCONTEXT_URL=http://127.0.0.1:8000
# 本地 launcher 的 PowerContext 仅监听回环地址，默认不启用鉴权。
# 若桥接到已启用鉴权的远程 PowerContext，则设置此项。
POWERCONTEXT_TOKEN=
