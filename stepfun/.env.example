# embedded: Windows x64 / Linux x64+arm64 / macOS arm64; binaries downloaded on first use
SEEKDB_MODE=embedded
SEEKDB_PATH=.data/seekdb
SEEKDB_DATABASE=stepfun
# Server alternative: docker compose up -d, then set SEEKDB_MODE=server
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
PORT=3000
# Local UI/API only. Never expose this unauthenticated personal app to the internet.
HOST=127.0.0.1
