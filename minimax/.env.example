# Copy to .env. Never commit credentials.
MINIMAX_API_KEY=
# Anthropic-compatible base URL (without /v1/messages)
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
MINIMAX_MODEL=MiniMax-M3.1-Flash
POWERCONTEXT_URL=http://127.0.0.1:18800
POWERCONTEXT_TOKEN=
# The launcher writes the local seekdb endpoint to .runtime/connection.json.
SEEKDB_MODE=server
# External seekdb/OceanBase: uncomment and configure all four variables.
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# SEEKDB_USER=root
# SEEKDB_PASSWORD=
SEEKDB_DATABASE=sdd_context
